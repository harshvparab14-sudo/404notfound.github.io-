<script>
  const user = DB.requireAuth();
  if (user) {
    document.getElementById("userName").textContent = `Hi, ${user.name.split(" ")[0]}`;
    const draft = DB.getDraft(user.email);

    const hasContent = draft.personal.name || draft.education.length || draft.experience.length || draft.projects.length;
    if (hasContent) {
      document.getElementById("uploadStatus").textContent = "Resume extracted";
      document.getElementById("uploadSub").textContent = "Re-upload anytime to start over.";
    }

    const sectionCount = draft.education.length + draft.experience.length + draft.projects.length + draft.achievements.length + draft.skills.length;
    if (sectionCount > 0) {
      document.getElementById("editStatus").textContent = `${sectionCount} entries in draft`;
      document.getElementById("editSub").textContent = "Keep refining, or move on to publish.";
    }

    if (draft.publishedSlug && DB.getPublished(draft.publishedSlug)) {
      document.getElementById("publishStatus").textContent = "Published";
      document.getElementById("publishSub").textContent = `/portfolio.html?u=${draft.publishedSlug}`;
      const link = `portfolio.html?u=${draft.publishedSlug}`;
      const viewBtn = document.getElementById("viewLiveBtn");
      viewBtn.href = link;
      viewBtn.classList.remove("hidden");
      const dashBtn = document.getElementById("dashViewBtn");
      dashBtn.href = link;
      dashBtn.classList.remove("hidden");
      document.getElementById("dashSlugLine").textContent = link;
    }
  }
</script>
