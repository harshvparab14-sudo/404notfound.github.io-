  --paper-dim:  #e7ddc0;
  --paper-text: #1c1a14;
  --highlight:  #ffc857;
  --highlight-2:#ff9f57;
  --signal:     #58d6b9;
  --text-hi:    #f6f3ea;
  --text-mid:   #b7b3a6;
  --text-dim:   #7c7b78;
  --danger:     #ff6b6b;

  /* type */
  --font-display: "Fraunces", Georgia, serif;
  --font-body: "Space Grotesk", "Segoe UI", sans-serif;
  --font-mono: "IBM Plex Mono", "Courier New", monospace;

  /* layout */
  --max: 1120px;
